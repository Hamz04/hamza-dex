# ============================================================
# HamzaDEX Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Your deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sepolia testnet RPC URL (get from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Mainnet RPC URL (for production deployment)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinMarketCap API key for gas reporter USD pricing (optional)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Report gas usage during tests (true/false)
REPORT_GAS=false
